# Azure shared library configuration (see `docs/containers/azure.md`)
AZURE_TENANT_ID=
HEAD_AZURE_CLIENT_ID=
HEAD_AZURE_CLIENT_SECRET=
BOT_AZURE_CLIENT_ID=
BOT_AZURE_CLIENT_SECRET=
WEB_AZURE_CLIENT_ID=
WEB_AZURE_CLIENT_SECRET=
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=DiscordCombatAI
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_QUEUE_NAME=suggestions
AZURE_METRICS_TABLE=NodeMetrics
AZURE_STATUS_BLOB_CONTAINER=coordination
AZURE_STATUS_BLOB_NAME=bot_status.json
AZURE_BATTLE_ARCHIVE_CONTAINER=battle-results
AZURE_LOG_ARCHIVE_CONTAINER=service-logs
AZURE_WEBPUBSUB_ENDPOINT=
AZURE_WEBPUBSUB_HUB_NAME=discordcombatai

# Browser auth for the web admin surface (see `docs/contracts/web_auth.md`)
WEB_ENTRA_TENANT_ID=
WEB_ENTRA_CLIENT_ID=
WEB_ENTRA_API_AUDIENCE=
WEB_ENTRA_ADMIN_GROUP_ID=
WEB_ENTRA_AUTHORITY=https://login.microsoftonline.com/{WEB_ENTRA_TENANT_ID}

# RabbitMQ broker identity and vhost (see `docs/containers/rabbitmq.md`)
RABBITMQ_DEFAULT_USER=discordcombatai
RABBITMQ_DEFAULT_PASS=change-me-in-env
RABBITMQ_DEFAULT_VHOST=/discordcombatai
BOT_RABBITMQ_USER=discordcombatai
BOT_RABBITMQ_PASS=change-me-in-env
AI_WORKER_RABBITMQ_USER=discordcombatai
AI_WORKER_RABBITMQ_PASS=change-me-in-env

# Mosquitto broker hostnames and ports (see `docs/containers/mosquitto.md`)
HEAD_MOSQUITTO_HOST=mosquitto
HEAD_MOSQUITTO_PORT=1883
BOT_MOSQUITTO_HOST=mosquitto
BOT_MOSQUITTO_PORT=1883
AI_WORKER_MOSQUITTO_HOST=mosquitto
AI_WORKER_MOSQUITTO_PORT=1883

# Head coordination and lifecycle settings (proposed defaults)
APPLICATION_VERSION=v0.1.0
HEAD_NODE_ID=node-local
HEAD_PUBSUB_CLUSTER_GROUP=cluster
HEAD_PUBSUB_DASHBOARD_GROUP=dashboard-live
HEAD_ELECTION_HEARTBEAT_SEC=30
HEAD_ELECTION_HEARTBEAT_TIMEOUT_SEC=90
HEAD_LEASE_BLOB_CONTAINER=coordination
HEAD_LEASE_BLOB_NAME=leader.lock
HEAD_LEASE_DURATION_SEC=60
HEAD_LOSS_OF_INTERNET_GRACE_SEC=0
HEAD_RECONNECT_BACKOFF_MAX_SEC=1800
HEAD_GITHUB_REPO=
HEAD_RELEASE_POLL_INTERVAL_SEC=300
HEAD_RELEASE_INCLUDE_PRERELEASE=false
HEAD_DRAIN_TIMEOUT_SEC=120
HEAD_BOT_STOP_ACK_TIMEOUT_SEC=15
HEAD_BOT_GRANT_TTL_SEC=45
HEAD_BOT_GRANT_RENEW_SEC=15
HEAD_METRICS_INTERVAL_SEC=2
HEAD_TELEMETRY_BATCH_INTERVAL_SEC=60
HEAD_TELEMETRY_LIVE_INTERVAL_SEC=10
HEAD_METRICS_BUFFER_MAX_BATCHES=60
HEAD_TELEMETRY_LIVE_MAX_LOGS=50
HEAD_TELEMETRY_LIVE_MAX_BYTES=65536
HEAD_SERVICE_HEARTBEAT_STALE_SEC=90
HEAD_LAUNCHER_IPC_URL=http://host.docker.internal:9700
HEAD_LAUNCHER_IPC_SECRET_FILE=/run/secrets/launcher_ipc_secret
HEAD_IPC_BIND=0.0.0.0
HEAD_IPC_PORT=9800
HEAD_IPC_HOST_PORT=9800

# Bot runtime settings (proposed defaults)
DISCORD_BOT_TOKEN=
BOT_DRAIN_PROGRESS_INTERVAL_SEC=5
BOT_QUEUE_POLL_INTERVAL_SEC=300
BOT_AI_TASK_STALL_TIMEOUT_SEC=120
BOT_AI_TASK_TIMEOUT_SEC=900
BOT_SUGGESTION_SWEEP_INTERVAL_SEC=900
BOT_SUGGESTION_SWEEP_MIN_AGE_SEC=600
BOT_SUGGESTION_MAX_DM_ATTEMPTS=5
BOT_GUILD_SYNC_INTERVAL_SEC=3600
BOT_HEARTBEAT_INTERVAL_SEC=30
BOT_STATUS_PUSH_INTERVAL_SEC=60
BOT_SHUTDOWN_GRACE_SEC=30
BOT_CONTROL_DRAIN_TIMEOUT_SEC=45
BOT_ACTIVATION_GRANT_MAX_TTL_SEC=60

# AI Worker runtime settings (proposed defaults)
AI_WORKER_RABBITMQ_HOST=rabbitmq
AI_WORKER_RABBITMQ_PORT=5672
AI_WORKER_MOSQUITTO_HOST=mosquitto
AI_WORKER_MOSQUITTO_PORT=1883
AI_WORKER_LLM_MAX_RETRIES=2
AI_WORKER_CELERY_CONCURRENCY=1
AI_WORKER_PROGRESS_HEARTBEAT_SEC=30
AI_WORKER_HEARTBEAT_INTERVAL_SEC=30

# Launcher IPC and update flow (see `docs/containers/Launcher.md`)
LAUNCHER_IPC_BIND=0.0.0.0
LAUNCHER_IPC_PORT=9700
LAUNCHER_IPC_SECRET_FILE=/run/secrets/launcher_ipc_secret
LAUNCHER_COMPOSE_FILE=docker-compose.yml
LAUNCHER_COMPOSE_PROJECT=discordcombatai
LAUNCHER_GHCR_NAMESPACE=
LAUNCHER_GHCR_TOKEN=
LAUNCHER_DOCKER_RETRY_INTERVAL_SEC=15
LAUNCHER_DOCKER_RETRY_MAX_SEC=0
LAUNCHER_HEALTHCHECK_TIMEOUT_SEC=300
LAUNCHER_HEALTHCHECK_INTERVAL_SEC=10
LAUNCHER_VERSION_HISTORY_PATH=./launcher_state.json
LAUNCHER_LOCK_PATH=./launcher.lock
LAUNCHER_LOG_PATH=./logs/launcher.log
