# Copy to launcher.env outside source control and restrict it to the service account.
LAUNCHER_IPC_BIND=0.0.0.0
LAUNCHER_IPC_PORT=9700
LAUNCHER_IPC_SECRET_FILE=C:\ProgramData\DiscordCombatAI\launcher_ipc_secret
HEAD_IPC_HOST_PORT=9800
LAUNCHER_COMPOSE_FILE=C:\ProgramData\DiscordCombatAI\docker-compose.yml
LAUNCHER_COMPOSE_PROJECT=discordcombatai
LAUNCHER_GHCR_NAMESPACE=ghcr.io/owner/discord-combat-ai
LAUNCHER_GHCR_TOKEN=replace-with-read-only-token
LAUNCHER_VERSION_HISTORY_PATH=C:\ProgramData\DiscordCombatAI\launcher_state.json
LAUNCHER_LOCK_PATH=C:\ProgramData\DiscordCombatAI\launcher.lock
LAUNCHER_LOG_PATH=C:\ProgramData\DiscordCombatAI\logs\launcher.log
